<?xml version="1.0" encoding="utf-8"?>
<!--
  Wraps the web app in a WebView so Android users can install it from a single
  .apk instead of hunting for "Add to Home Screen". The page itself is the same
  production site the browser and desktop app point at.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bloodconnect.app"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Blood Connect"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
